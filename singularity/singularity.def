Bootstrap: library
From: airl_lab/default/airl_env:qdax_f57720d0

%files
   ../requirements.txt /requirements.txt

%labels
    Author manon.flageat18@imperial.ac.uk
    Version v0.0.1

%environment
   export PYTHONPATH=$PYTHONPATH:/workspace/lib/python3.8/site-packages/
   export LD_LIBRARY_PATH="/workspace/lib:$LD_LIBRARY_PATH"
   export PATH=$PATH:/usr/local/go/bin

%post
   export LD_LIBRARY_PATH="/workspace/lib:$LD_LIBRARY_PATH"
   export MPLCONFIGDIR="/configs/"
   apt-get update -y
   pip3 install --upgrade pip

   # Install requirements
   pip3 install -r requirements.txt

   # Create working directory
   mkdir -p /git/exp/uncertain_quality_diversity/

   #==================================================================================
   exit 0 #NOTFORFINAL - the lines below this "exit" will be executed only when building the final image
   #==================================================================================

   # Enter working directory
   cd /git/exp/
   git clone https://github.com/adaptive-intelligent-robotics/Uncertain_Quality_Diversity.git

%runscript

    # Create results folders
    echo
    echo "Entering directory /git/exp/uncertain_quality_diversity"
    CURPATH=$(pwd)
    cd /git/exp/uncertain_quality_diversity

    echo
    echo "Creating result directory $CURPATH/$DIRNAME/"
    DIRNAME=results_$1
    mkdir -p $CURPATH/$DIRNAME/

    if [ ! -z "${PBS_ARRAY_INDEX}" ]
      then
        tmp_dir=$CURPATH/$DIRNAME/$DIRNAME.${PBS_ARRAY_INDEX}
    else
      PATHNAME=$(date +%Y-%m-%d_%H_%M_%S)_$$
      tmp_dir=$(mktemp -d -p $CURPATH/$DIRNAME/ $PATHNAME.XXX)
    fi
    mkdir -p $tmp_dir
    echo
    echo "Created $tmp_dir"

    # Read number of replications
    REPLICATIONS=$2
    echo
    echo "Replicating run $REPLICATIONS times"

    shift
    shift

    # Run experiments
    for RUN in $(seq 1 $REPLICATIONS)
    do
        echo
        echo "Running python3 main.py --results $tmp_dir $@"
        python3 main.py --results $tmp_dir "$@"
    done

%apprun reeval_tunning

    # Create results folders
    echo
    echo "Entering directory /git/exp/uncertain_quality_diversity"
    CURPATH=$(pwd)
    cd /git/exp/uncertain_quality_diversity

    echo
    echo "Creating result directory $CURPATH/$DIRNAME/"
    DIRNAME=results_$1
    mkdir -p $CURPATH/$DIRNAME/

    if [ ! -z "${PBS_ARRAY_INDEX}" ]
      then
        tmp_dir=$CURPATH/$DIRNAME/$DIRNAME.${PBS_ARRAY_INDEX}
    else
      PATHNAME=$(date +%Y-%m-%d_%H_%M_%S)_$$
      tmp_dir=$(mktemp -d -p $CURPATH/$DIRNAME/ $PATHNAME.XXX)
    fi
    mkdir -p $tmp_dir
    echo
    echo "Created $tmp_dir"

    # Read number of replications
    REPLICATIONS=$2
    echo
    echo "Replicating run $REPLICATIONS times"

    shift
    shift

    # Run experiments
    for RUN in $(seq 1 $REPLICATIONS)
    do
        echo
        echo "Running python3 main_reeval_tunning.py --results $tmp_dir $@"
        python3 main_reeval_tunning.py --results $tmp_dir "$@"
    done

%apprun size_runscript

    # Create results folders
    echo
    echo "Entering directory /git/exp/uncertain_quality_diversity"
    CURPATH=$(pwd)
    cd /git/exp/uncertain_quality_diversity

    echo
    echo "Creating result directory $CURPATH/$DIRNAME/"
    DIRNAME=results_$1
    mkdir -p $CURPATH/$DIRNAME/

    # Read number of replications
    REPLICATIONS=$2
    echo
    echo "Replicating run $REPLICATIONS times for sampling sizes: 4096 16384, not running: 256 1024"

    shift
    shift

    # Run experiments
    for SIZE in 4096 16384
    do
        if [ ! -z "${PBS_ARRAY_INDEX}" ]
        then
            tmp_dir=$CURPATH/$DIRNAME/$DIRNAME.${PBS_ARRAY_INDEX}_$SIZE
        else
            PATHNAME=$(date +%Y-%m-%d_%H_%M_%S)_$$
            tmp_dir=$(mktemp -d -p $CURPATH/$DIRNAME/$PATHNAME.XXX_$SIZE)
        fi
        mkdir -p $tmp_dir
        echo
        echo "Created $tmp_dir"

	for RUN in $(seq 1 $REPLICATIONS)
        do
            echo
	    echo "Running replication $RUN"
            echo "Running python3 main.py --results $tmp_dir --sampling-size $SIZE --size-log-period $@"
            python3 main.py --results $tmp_dir --sampling-size $SIZE --size-log-period "$@"
        done
    done


%apprun Analysis
    PATH_ANALYSIS=$1
    shift

    # Run analysis
    echo
    echo "Entering directory /git/exp/uncertain_quality_diversity"
    cd /git/exp/uncertain_quality_diversity/
    echo
    echo "Running python3 main_num_reevals_tunning.py --results $PATH_ANALYSIS --plots $PATH_ANALYSIS --min-replications 64 --max-replications 16384 "$@""
    python3 main_num_reevals_tunning.py --results $PATH_ANALYSIS --plots $PATH_ANALYSIS --min-replications 64 --max-replications 16384 "$@"


%help
    This container allows to run QDax implementation of Uncertain Quality-Diversity.
